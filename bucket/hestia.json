{
    "version": "1.8.1",
    "description": "A feature-rich mod manager for organizing, discovering, installing, and updating mods for XXMI-based games and certain Unreal Engine games.",
    "homepage": "https://github.com/HenryNugraha/Hestia",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/HenryNugraha/Hestia/releases/download/1.8.1/hestia.exe",
            "hash": "0442518a8c5ff62d97d9335cb15fda7f26a62ab578ee9c5b51afafef9b3a9302"
        }
    },
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) { New-Item -ItemType Directory -Path \"$persist_dir\" -Force | Out-Null }",
        "if (!(Test-Path \"$persist_dir\\hestia.toml\")) {",
        "    $config = @'",
        "version = 7",
        "app_version = \"1.8.1\"",
        "games = []",
        "library_folders = []",
        "show_log = false",
        "show_tasks = false",
        "show_tools = false",
        "startup_path_scan_completed = true",
        "tasks_layout = \"SingleList\"",
        "tasks_order = \"OldestFirst\"",
        "auto_game_enable_done = false",
        "tools = []",
        "categories = []",
        "category_sort_mode_by_game = {}",
        "create_downloaded_mod_category_by_game = {}",
        "last_update_check_time_by_game = {}",
        "profiles_by_game = {}",
        "feedback_survey = {}",
        "automatically_check_for_update = false",
        "'@",
        "    Set-Content -LiteralPath \"$persist_dir\\hestia.toml\" -Encoding ascii -Value $config",
        "}",
        "if (!(Test-Path \"$persist_dir\\hestia.dat\")) {",
        "    New-Item -ItemType File -Path \"$persist_dir\\hestia.dat\" -Force | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "hestia.exe",
            "Hestia"
        ]
    ],
    "persist": [
        "hestia.toml",
        "hestia.dat"
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App"
    ],
    "checkver": {
        "github": "https://github.com/HenryNugraha/Hestia"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/HenryNugraha/Hestia/releases/download/$version/hestia.exe"
            }
        }
    }
}
