{
    "version": "2.1.6",
    "description": "PiliNara - 第三方BiliBili客户端 (BiliBili third-party client)",
    "homepage": "https://github.com/Starfallan/PiliNara",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/Starfallan/PiliNara/releases/download/2.1.6/PiliNara_windows_2.1.6%2B6057_x64_portable.zip",
            "hash": "b0e42541f07053d9ab6ffd54551174ac74827347f401d0b4671d786202dfcf72",
            "extract_dir": "PiliNara-Win"
        }
    },
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\com.example.piliplus\" \"$persist_dir\\AppData\" -Migrate"
        ]
    },
    "shortcuts": [
        [
            "pilinara.exe",
            "PiliNara"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\com.example.piliplus\""
    ],
    "checkver": {
        "url": "https://api.github.com/repos/Starfallan/PiliNara/releases/latest",
        "regex": "\"tag_name\"\\s*:\\s*\"([^\"]+)\"[\\s\\S]*?PiliNara_windows_([\\d.]+)%2B(\\d+)_x64_portable\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Starfallan/PiliNara/releases/download/$version/PiliNara_windows_$match2%2B$match3_x64_portable.zip"
            }
        }
    }
}
