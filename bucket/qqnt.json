            "hash": "7bcc1ad50c19d14c9aad17778a0359aacd84b4d6c54ef1c71d938e0a6e2f2f5d"
        },
        "32bit": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/a0ce07ad/QQ_9.9.33_260730_x86_01.exe#/dl.7z",
            "hash": "f277c8e6139fad03c4bb59d91eb00811f5cab9f2bade77edc44a49e7aa431342"
        },
        "arm64": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/a0ce07ad/QQ_9.9.33_260730_arm64_01.exe#/dl.7z",
            "hash": "3568e15927a0f799fc4bc1b39fd1477185d5ccaa67452c2401fe5144e66c86b7"
        }
    },
    "installer": {
        "script": [
            "$configpath = \"$([Environment]::GetFolderPath('CommonDocuments'))\\Tencent\\QQ\"",
            "if (!(Test-Path -Path \"$configpath\")) {",
            "    New-Item -Path \"$configpath\" -Type Directory -Force -ErrorAction SilentlyContinue | Out-Null",
            "}",
            "if (!(Test-Path -Path \"$configpath\\UserDataInfo.ini\" -PathType leaf)) {",
            "    Set-Content -NoNewline -Path \"$configpath\\UserDataInfo.ini\" -Value \"[UserDataSet]`nUserDataSavePathType=2`nUserDataSavePath=`\"$persist_dir\\Tencent Files`\"\"",
            "}"
        ]
    },
    "shortcuts": [
        [
            "Files\\QQ.exe",
            "QQ"
        ]
    ],
    "persist": "Tencent Files",
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Remove-Item -Path \"$([Environment]::GetFolderPath('CommonDocuments'))\\Tencent\" -Recurse -Force -ErrorAction SilentlyContinue | Out-Null",
            "    Remove-Item -Path \"$env:AppData\\QQ\" -Recurse -Force -ErrorAction SilentlyContinue | Out-Null",
            "}"
        ]
    },
    "checkver": {
        "script": [
            "# Please keep this script. Using 'cdn-go.cn' may result in receiving expired cache responses.",
            "$url = 'https://cdn-go.cn/qq-web/im.qq.com_new/latest/rainbow/windowsConfig.js'",
            "$hostname = ([Uri]$url).Host",
            "$records = Resolve-DnsName 'cdn-go.cn.cloud.tc.qq.com' -Type A -DnsOnly -ErrorAction Ignore",
            "$ip = $records | Where-Object { $_.QueryType -eq 'A' -and $_.IPAddress } | Select-Object -ExpandProperty IP4Address -First 1",
            "$url = $url -Replace [regex]::Escape($hostname), $ip",
            "Invoke-WebRequest -Uri $url -UseBasicParsing -Headers @{'Host' = $hostname} | Select-Object -ExpandProperty Content"
        ],
        "regex": "QQNT/([\\d.]+)/release/([a-z0-9]+)/QQ_[\\d.]+_(\\d+)_x86_01.exe",
        "replace": "${1}.${3}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNT/$match1/release/$match2/QQ_$match1_$match3_x64_01.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNT/$match1/release/$match2/QQ_$match1_$match3_x86_01.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNT/$match1/release/$match2/QQ_$match1_$match3_arm64_01.exe#/dl.7z"
            }
        }
    }
}
