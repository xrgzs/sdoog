            "hash": "9afd6353abf1356c894afc55679dcaf18e3ca2e5f3045210f1f30ca373eab89f"
        },
        "arm64": {
            "url": "https://github.com/Uotan-Dev/UotanToolboxNT/releases/download/3.7.2/UotanToolbox_Windows_arm64_3.7.2.zip",
