{
    "version": "26.2.0",
    "description": "Free universal database tool and SQL client",
    "homepage": "https://dbeaver.io",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dbeaver/dbeaver/releases/download/26.2.0/dbeaver-ce-26.2.0-windows-x86_64.zip",
            "hash": "a2429b50e3e5ab0b5aeee4abea5bbbdae1968173996488fd592f43781058baca"
        },
        "arm64": {
            "url": "https://github.com/dbeaver/dbeaver/releases/download/26.2.0/dbeaver-ce-26.2.0-windows-aarch64.zip",
            "hash": "d9f2f64cf8c127362eeab072ddfe5793483b90c38c89e86a60c0a6a9521fdcc4"
        }
    },
    "extract_dir": "dbeaver",
    "bin": [
        "dbeaver.exe",
        "dbeaverc.exe"
    ],
    "shortcuts": [
        [
            "dbeaver.exe",
            "DBeaver"
        ]
    ],
    "installer": {
        "script": [
            "Remove-Item \"$dir\\`$*\" -Recurse -Force",
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\DBeaverData\" \"$persist_dir\\AppData\" -Migrate"
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\DBeaverData\""
    ],
    "checkver": {
        "github": "https://github.com/dbeaver/dbeaver"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dbeaver/dbeaver/releases/download/$version/dbeaver-ce-$version-windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/dbeaver/dbeaver/releases/download/$version/dbeaver-ce-$version-windows-aarch64.zip"
            }
        }
    }
}
