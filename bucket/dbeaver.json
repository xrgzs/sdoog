{
    "version": "26.1.4",
    "description": "Free universal database tool and SQL client",
    "homepage": "https://dbeaver.io",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dbeaver/dbeaver/releases/download/26.1.4/dbeaver-ce-26.1.4-windows-x86_64.zip",
            "hash": "27bda23dc227760f9a48beee631d353b1d5b8c8ddb3096c6d66259fa860e0a45"
        },
        "arm64": {
            "url": "https://github.com/dbeaver/dbeaver/releases/download/26.1.4/dbeaver-ce-26.1.4-windows-aarch64.zip",
            "hash": "3cac00db35ffcffca049fedc5337eb470ca2bf94629b283a7e731050eb06f75b"
        }
    },
    "extract_dir": "dbeaver",
    "bin": [
        "dbeaver.exe",
        "dbeaverc.exe"
    ],
    "shortcuts": [
        [
            "dbeaver.exe",
            "DBeaver"
        ]
    ],
    "installer": {
        "script": [
            "Remove-Item \"$dir\\`$*\" -Recurse -Force",
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\DBeaverData\" \"$persist_dir\\AppData\" -Migrate"
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\DBeaverData\""
    ],
    "checkver": {
        "github": "https://github.com/dbeaver/dbeaver"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dbeaver/dbeaver/releases/download/$version/dbeaver-ce-$version-windows-x86_64.zip"
            },
            "arm64": {
                "url": "https://github.com/dbeaver/dbeaver/releases/download/$version/dbeaver-ce-$version-windows-aarch64.zip"
            }
        }
    }
}
