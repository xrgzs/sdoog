{
    "version": "1.1.0",
    "description": "DSH Pack: Tauri desktop client for DeepSeek Harness with curated plugins and a bundled runtime.",
    "homepage": "https://github.com/myYangyunfan/dsh_desktop",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/myYangyunfan/dsh_desktop/releases/download/v1.1.0/DSH-Desktop-Portable-1.1.0-win-x64.zip",
            "hash": "e3d248824d2991490d07f2cce9929e1336e899230aa8f5abb361dcf6d1227119"
        }
    },
    "extract_dir": "DSH Desktop",
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "$dsh_path = Join-Path $env:USERPROFILE '.dsh'",
            "$persist_dsh = Join-Path $persist_dir 'USERPROFILE\\.dsh'",
            "$legacy_dsh = Join-Path (Split-Path $persist_dir -Parent) 'deepseek-harness-desktop\\USERPROFILE\\.dsh'",
            "$dsh_item = Get-Item -LiteralPath $dsh_path -ErrorAction SilentlyContinue",
            "$source_dsh = $null",
            "if ($dsh_item -and $dsh_item.LinkType -eq 'Junction') {",
            "    $source_dsh = $dsh_path",
            "} elseif (!$dsh_item -and (Test-Path $legacy_dsh)) {",
            "    $source_dsh = $legacy_dsh",
            "}",
            "if ($source_dsh -and !(Test-Path $persist_dsh)) {",
            "    New-Item $persist_dsh -ItemType Directory -Force | Out-Null",
            "    Get-ChildItem -LiteralPath $source_dsh -Force | Copy-Item -Destination $persist_dsh -Recurse -Force",
            "}",
            "New-PersistDirectory $dsh_path $persist_dsh -Migrate"
        ]
    },
    "shortcuts": [
        [
            "DSH Desktop.exe",
            "DSH Desktop"
        ]
    ],
    "persist": "data",
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:USERPROFILE\\.dsh\""
    ],
    "checkver": {
        "github": "https://github.com/myYangyunfan/dsh_desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/myYangyunfan/dsh_desktop/releases/download/v$version/DSH-Desktop-Portable-$version-win-x64.zip"
            }
        }
    }
}
