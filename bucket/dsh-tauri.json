{
    "version": "0.34.0",
    "description": "Tauri desktop client for DeepSeek Harness with runtime and plugin management.",
    "homepage": "https://github.com/dsh-tauri/deepseek-harness-desktop",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/dsh-tauri/deepseek-harness-desktop/releases/download/v0.34.0/Deepseek.Harness.Desktop_Bundle_0.34.0.exe#/dl.7z",
            "hash": "178f69eb9ae8ef4dec3bfca00a485accb75c4145c6fe7e9a324ca4432397056e"
        }
    },
    "installer": {
        "script": [
            "Remove-Item \"$dir\\uninstall.exe\", \"$dir\\`$*\" -Force -Recurse -ErrorAction SilentlyContinue | Out-Null",
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\dsh-tauri\" \"$persist_dir\\AppData\" -Migrate",
            "$dsh_path = Join-Path $env:USERPROFILE '.dsh'",
            "$persist_dsh = Join-Path $persist_dir 'USERPROFILE\\.dsh'",
            "$legacy_dsh = Join-Path (Split-Path $persist_dir -Parent) 'deepseek-harness-desktop\\USERPROFILE\\.dsh'",
            "$dsh_item = Get-Item -LiteralPath $dsh_path -ErrorAction SilentlyContinue",
            "$source_dsh = $null",
            "if ($dsh_item -and $dsh_item.LinkType -eq 'Junction') {",
            "    $source_dsh = $dsh_path",
            "} elseif (!$dsh_item -and (Test-Path $legacy_dsh)) {",
            "    $source_dsh = $legacy_dsh",
            "}",
            "if ($source_dsh -and !(Test-Path $persist_dsh)) {",
            "    New-Item $persist_dsh -ItemType Directory -Force | Out-Null",
            "    Get-ChildItem -LiteralPath $source_dsh -Force | Copy-Item -Destination $persist_dsh -Recurse -Force",
            "}",
            "New-PersistDirectory $dsh_path $persist_dsh -Migrate"
        ]
    },
    "shortcuts": [
        [
            "deepseek-harness-desktop.exe",
            "DSH Tauri"
        ]
    ],
    "persist": [
        "AppData",
        "USERPROFILE\\.dsh",
        "data"
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\dsh-tauri\"",
        "Remove-Junction \"$env:USERPROFILE\\.dsh\""
    ],
    "checkver": {
        "github": "https://github.com/dsh-tauri/deepseek-harness-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/dsh-tauri/deepseek-harness-desktop/releases/download/v$version/Deepseek.Harness.Desktop_Bundle_$version.exe#/dl.7z"
            }
        }
    }
}
