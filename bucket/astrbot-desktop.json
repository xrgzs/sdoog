            "hash": "9bbbf5dfd8517a1fd429d421f534912d6947b8bcb14a5c99ebdec14ef9333587"
        },
        "arm64": {
            "url": "https://github.com/AstrBotDevs/AstrBot-desktop/releases/download/v4.28.0/AstrBot_4.28.0_windows_arm64_setup.exe#/dl.7z",
            "hash": "9897f7cef5451904a2f6d6f1b8ce5e2b983f382198e94a93817f390ac20c13a7"
        }
    },
    "shortcuts": [
        [
            "astrbot-desktop-tauri.exe",
            "AstrBot"
        ]
    ],
    "pre_install": [
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "New-PersistDirectory \"$env:LOCALAPPDATA\\com.astrbot.desktop.tauri\" \"$persist_dir\\LocalAppData\" -Migrate"
    ],
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall.exe\" -Force -Recurse -ErrorAction Ignore | Out-Null",
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:LOCALAPPDATA\\com.astrbot.desktop.tauri\""
    ],
    "checkver": {
        "github": "https://github.com/AstrBotDevs/AstrBot-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AstrBotDevs/AstrBot-desktop/releases/download/v$version/AstrBot_$version_windows_amd64_setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/AstrBotDevs/AstrBot-desktop/releases/download/v$version/AstrBot_$version_windows_arm64_setup.exe#/dl.7z"
            }
        }
    }
}
