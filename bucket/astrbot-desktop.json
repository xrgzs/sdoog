{
    "version": "4.27.0",
    "description": "The desktop edition of AstrBot, designed for fast local installation and convenient access to ChatUI and plugins.",
    "homepage": "https://astrbot.app/",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/AstrBotDevs/AstrBot-desktop/releases/download/v4.27.0/AstrBot_4.27.0_windows_amd64_setup.exe#/dl.7z",
            "hash": "9e9bd7f28315becdb7adcf6d318b1e313003aeaec8388a7cfcd548f511818ad1"
        },
        "arm64": {
            "url": "https://github.com/AstrBotDevs/AstrBot-desktop/releases/download/v4.27.0/AstrBot_4.27.0_windows_arm64_setup.exe#/dl.7z",
            "hash": "5b9ecfed49b429fb5ee23160cd0045215d9468c0f52faf7a986baadd3e010099"
        }
    },
    "shortcuts": [
        [
            "astrbot-desktop-tauri.exe",
            "AstrBot"
        ]
    ],
    "pre_install": [
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "New-PersistDirectory \"$env:LOCALAPPDATA\\com.astrbot.desktop.tauri\" \"$persist_dir\\LocalAppData\" -Migrate"
    ],
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall.exe\" -Force -Recurse -ErrorAction Ignore | Out-Null",
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:LOCALAPPDATA\\com.astrbot.desktop.tauri\""
    ],
    "checkver": {
        "github": "https://github.com/AstrBotDevs/AstrBot-desktop"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/AstrBotDevs/AstrBot-desktop/releases/download/v$version/AstrBot_$version_windows_amd64_setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/AstrBotDevs/AstrBot-desktop/releases/download/v$version/AstrBot_$version_windows_arm64_setup.exe#/dl.7z"
            }
        }
    }
}
