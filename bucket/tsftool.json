{
    "version": "2026.09.01.176721",
    "description": "输入法设置工具",
    "homepage": "https://www.mympc.org/default/tsftool.html",
    "license": "Freeware",
    "url": "https://fastly.mirror.pkgbuild.com/wsl/2026.09.01.176721/archlinux-2026.09.01.176721.wsl",
    "hash": "7b35e65ee0f0e1ea80a7048aeee96f141c8ebb97cc67699b32fdd6409e8114b9",
    "architecture": {
        "64bit": {
            "extract_dir": "Win64"
        },
        "32bit": {
            "extract_dir": "Win32"
        }
    },
    "shortcuts": [
        [
            "TSFTool.exe",
            "TSFTool"
        ]
    ],
    "checkver": {
        "script": [
            "$url = \"https://mympc.org/default/tsftool.html\"",
            "$html = Invoke-WebRequest -Uri $url -UseBasicParsing",
            "if ($html.Content -match 'TSFTool V([\\d.]+)') {",
            "    $version = $matches[1]",
            "} else {",
            "    Write-Host \"Version not found\"",
            "    return",
            "}",
            "if ($html.Content -match 'https://www\\.mympc\\.org/usr/uploads/\\d{4}/\\d{2}/tsftool\\.rar') {",
            "    $url = $matches[0]",
            "} else {",
            "    Write-Host \"Download URL not found\"",
            "    return",
            "}",
            "return \"$version=====$url\""
        ],
        "regex": "(.*)=====(?<url>.*)"
    },
    "autoupdate": {
        "url": "$matchUrl"
    }
}
