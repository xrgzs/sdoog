{
    "version": "0.5.3",
    "description": "Rust 驱动的多协议下载管理器，支持 HTTP/FTP/BitTorrent 磁力链接及 HLS/DASH 流媒体，智能多线程加速与浏览器无缝集成。精美界面，极致性能，永久免费，零广告。",
    "homepage": "https://fluxdown.zerx.dev/",
    "license": "AGPL-3.0-only",
    "suggest": {
        "FluxDown-CLI": "sdoog/fluxdown-cli"
    },
    "architecture": {
        "64bit": {
            "url": "https://fluxdown.zerx.dev/api/download/FluxDown-0.5.3-windows-x64-portable.zip",
            "hash": "c96da20b33e6eda541c983716d240f2c41791fee5a27f9957d6993604469fe35"
        },
        "arm64": {
            "url": "https://fluxdown.zerx.dev/api/download/FluxDown-0.5.3-windows-arm64-portable.zip",
            "hash": "6f8bc0a227201feb0c4ee2fbb6eb3b74060d0da6f043d3e0c5d606d45e2b4dc0"
        }
    },
    "shortcuts": [
        [
            "fluxdown-desktop.exe",
            "FluxDown"
        ]
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\FluxDown\" \"$persist_dir\\AppData\" -Migrate",
            "# The portable FluxDown saves SQLite database in program directory.",
            "# To avoid data loss, we turn it into non-portable.",
            "Remove-Item \"$dir\\portable\" -Force",
            "New-PersistDirectory \"$env:LOCALAPPDATA\\FluxDown\" \"$persist_dir\\LocalAppData\" -Migrate",
            "",
            "# Register URL protocol, torrent file association, and auto-start",
            "if ($global) {",
            "    $registry_scope = \"HKEY_LOCAL_MACHINE\"",
            "} else {",
            "    $registry_scope = \"HKEY_CURRENT_USER\"",
            "}",
            "$instdir = $($dir -replace '\\\\', '\\\\')",
            "@\"",
            "Windows Registry Editor Version 5.00",
            "",
            "[$registry_scope\\SOFTWARE\\Classes\\fluxdown]",
            "@=\"URL:FluxDown Protocol\"",
            "\"URL Protocol\"=\"\"",
            "",
            "[$registry_scope\\SOFTWARE\\Classes\\fluxdown\\DefaultIcon]",
            "@=\"\\\"$instdir\\flux_down.exe\\\",0\"",
            "",
            "[$registry_scope\\SOFTWARE\\Classes\\fluxdown\\shell\\open\\command]",
            "@=\"\\\"$instdir\\flux_down.exe\\\" \\\"%1\\\"\"",
            "",
            "[$registry_scope\\SOFTWARE\\Classes\\FluxDown.TorrentFile]",
            "@=\"BitTorrent File\"",
            "",
            "[$registry_scope\\SOFTWARE\\Classes\\FluxDown.TorrentFile\\DefaultIcon]",
            "@=\"\\\"$instdir\\flux_down.exe\\\",0\"",
            "",
            "[$registry_scope\\SOFTWARE\\Classes\\FluxDown.TorrentFile\\shell\\open\\command]",
            "@=\"\\\"$instdir\\flux_down.exe\\\" \\\"%1\\\"\"",
            "",
            "[$registry_scope\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run]",
            "\"FluxDown\"=\"\\\"$instdir\\flux_down.exe\\\" --silentStart\"",
            "\"@ | Set-Content -Path \"$dir\\install-fluxdown.reg\" -Encoding Unicode",
            "",
            "reg import \"$dir\\install-fluxdown.reg\""
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\FluxDown\"",
        "Remove-Junction \"$env:LOCALAPPDATA\\FluxDown\"",
        "",
        "# Clean up registry entries",
        "if ($global) {",
        "    $registry_scope = \"HKLM\"",
        "} else {",
        "    $registry_scope = \"HKCU\"",
        "}",
        "reg.exe delete \"$registry_scope\\SOFTWARE\\Classes\\fluxdown\" /f",
        "reg.exe delete \"$registry_scope\\SOFTWARE\\Classes\\FluxDown.TorrentFile\" /f",
        "reg.exe delete \"$registry_scope\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run\" /v \"FluxDown\" /f"
    ],
    "checkver": {
        "url": "https://fluxdown.zerx.dev/api/release",
        "jsonpath": "$.version"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://fluxdown.zerx.dev/api/download/FluxDown-$version-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://fluxdown.zerx.dev/api/download/FluxDown-$version-windows-arm64-portable.zip"
            }
        }
    }
}
