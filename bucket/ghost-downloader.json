        },
        "arm64": {
            "url": "https://github.com/XiaoYouChR/Ghost-Downloader-3/releases/download/v4.3.5/Ghost-Downloader-v4.3.5-Windows-arm64.zip",
            "hash": "b6403b44fa935698ebd23ac1553b9678196c9fc76f9e42607f7a209112c789de"
