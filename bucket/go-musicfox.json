{
    "version": "5.1.1",
    "description": "go-musicfox 是用 Go 写的又一款网易云音乐命令行客户端，支持各种音质级别、UnblockNeteaseMusic、Last.fm、MPRIS 和 macOS 交互响应（睡眠暂停、蓝牙耳机连接断开响应和菜单栏控制等）等功能特性。.",
    "homepage": "https://github.com/go-musicfox/go-musicfox",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/go-musicfox/go-musicfox/releases/download/v5.1.1/go-musicfox_5.1.1_windows_amd64.zip",
            "hash": "e3e6c42bada80881185c6d71b12ed8179516b347989c7463221e5462cab5a38c",
            "extract_dir": "go-musicfox_5.1.1_windows_amd64"
        },
        "arm64": {
            "url": "https://github.com/go-musicfox/go-musicfox/releases/download/v5.1.1/go-musicfox_5.1.1_windows_arm64.zip",
            "hash": "92856a01d9f93e69dd4aed027678741420113391da08f94294cc9b0a59f59486",
            "extract_dir": "go-musicfox_5.1.1_windows_arm64"
        }
    },
    "bin": "musicfox.exe",
    "shortcuts": [
        [
            "musicfox.exe",
            "musicfox"
        ]
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:USERPROFILE\\.go-musicfox\" \"$persist_dir\\.go-musicfox\" -Migrate"
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:USERPROFILE\\.go-musicfox\""
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/go-musicfox/go-musicfox/releases/download/v$version/go-musicfox_$version_windows_amd64.zip",
                "extract_dir": "go-musicfox_$version_windows_amd64"
            },
            "arm64": {
                "url": "https://github.com/go-musicfox/go-musicfox/releases/download/v$version/go-musicfox_$version_windows_arm64.zip",
                "extract_dir": "go-musicfox_$version_windows_arm64"
            }
        }
    }
}
