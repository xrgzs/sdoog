    "shortcuts": [
        [
            "PicList.exe",
            "PicList"
        ]
    ],
    "installer": {
        "script": [
            "Remove-Item \"$dir\\`$*\" -Force -Recurse",
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\PicList\" \"$persist_dir\\AppData\" -Migrate"
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\PicList\""
    ],
    "checkver": {
        "github": "https://github.com/Kuingsmile/PicList"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/Kuingsmile/PicList/releases/download/v$version/PicList-Setup-$version-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/Kuingsmile/PicList/releases/download/v$version/PicList-Setup-$version-arm64-portable.zip"
            }
        }
    }
