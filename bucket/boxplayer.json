{
    "version": "5.0.17",
    "description": "BoxPlayer（小白羊网盘）是免费开源的跨平台云盘管理器与 AI 智能搜索助手。支持阿里云盘、百度网盘、115、夸克、OneDrive、Google Drive、Dropbox、PikPak 等 10+ 网盘管理，AI 智能搜索，4K HDR 视频播放，Plex/Jellyfin/Emby 客户端。",
    "homepage": "https://xbyvideohub.com/",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/gaozhangmin/boxplayer/releases/download/v5.0.17/boxplayer-5.0.17-win-x64.exe#/dl.7z",
            "hash": "sha512:e61e0f8273afdba069190979f878834ac43cd9d9806d04c88faa0ff766b410fc3c12d50c17740414eec9ae39f27a4ad860d02054fa7372d0f71bfeeb94123535",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        }
    },
    "bin": [
        [
            "clouddrive-cli",
            "$dir\\BoxPlayer.exe",
            "$dir\\resources\\cli\\clouddrive-cli.mjs"
        ],
        [
            "clouddrive-mcp",
            "$dir\\BoxPlayer.exe",
            "$dir\\resources\\cli\\clouddrive-mcp.mjs"
        ]
    ],
    "shortcuts": [
        [
            "BoxPlayer.exe",
            "BoxPlayer"
        ]
    ],
    "installer": {
        "script": [
            "Remove-Item \"$dir\\`$*\" -Force -Recurse",
            "Remove-Item \"$dir\\resources\\app-update.yml\" -Force -ErrorAction SilentlyContinue",
            "# Register URL protocols: boxplayer-auth, boxplayer-onedriveoauth, xbyboxplayer-oauth",
            "if ($global) { $regRoot = 'HKLM:' } else { $regRoot = 'HKCU:' }",
            "@('boxplayer-auth', 'boxplayer-onedriveoauth', 'xbyboxplayer-oauth') | ForEach-Object {",
            "    New-Item \"$regRoot\\SOFTWARE\\Classes\\$_\" -Force -ItemType String -Value \"URL:$_\" | Out-Null",
            "    New-ItemProperty \"$regRoot\\SOFTWARE\\Classes\\$_\" -Force -PropertyType string -Name 'URL Protocol' -Value '' | Out-Null",
            "    New-Item \"$regRoot\\SOFTWARE\\Classes\\$_\\shell\\open\\command\" -Force -ItemType String -Value \"`\"$dir\\BoxPlayer.exe`\" `\"%1`\"\" | Out-Null",
            "}",
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:LOCALAPPDATA\\BoxPlayer\" \"$persist_dir\\LocalAppData\" -Migrate",
            "New-PersistDirectory \"$env:APPDATA\\BoxPlayer\" \"$persist_dir\\AppData\" -Migrate",
            "New-PersistDirectory \"$env:USERPROFILE\\.clouddrive-cli\" \"$persist_dir\\.clouddrive-cli\" -Migrate"
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\BoxPlayer\"",
        "Remove-Junction \"$env:LOCALAPPDATA\\BoxPlayer\"",
        "Remove-Junction \"$env:USERPROFILE\\.clouddrive-cli\"",
        "# Cleanup URL protocols",
        "if ($global) { $regRoot = 'HKLM' } else { $regRoot = 'HKCU' }",
        "@('boxplayer-auth', 'boxplayer-onedriveoauth', 'xbyboxplayer-oauth') | ForEach-Object {",
        "    reg.exe delete \"$regRoot\\SOFTWARE\\Classes\\$_\" /f *>$null",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/gaozhangmin/boxplayer"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/gaozhangmin/boxplayer/releases/download/v$version/boxplayer-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "mode": "extract",
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s+$base64"
                }
            }
        }
    }
}
