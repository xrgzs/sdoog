{
    "version": "1.22.3b",
    "description": "A open-source browser based on the Firefox engine",
    "homepage": "https://www.zen-browser.app/",
    "license": "MPL-2.0",
    "notes": [
        "To set profile 'Scoop' as *DEFAULT*, or profiles/settings was lost after update:",
        "  - Run 'Zen Browser Profile Manager', choose 'Scoop' then click 'Start Zen Browser'.",
        "  - Visit 'about:profiles' page in Zen Browser to check *DEFAULT* profile.",
        "For details: https://support.mozilla.org/en-US/kb/profile-manager-create-remove-switch-firefox-profiles",
        "Auto-update is disabled via distribution\\policies.json."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/zen-browser/desktop/releases/download/1.22.3b/zen.installer.exe#/dl.7z",
            "hash": "1275177145fe6064e1a214bd76c1e0a2f134b0688b5162c2ec58b18a61dc84a9"
        },
        "arm64": {
            "url": "https://github.com/zen-browser/desktop/releases/download/1.22.3b/zen.installer-arm64.exe#/dl.7z",
            "hash": "b87b412e01cd652f62dd294bfc69f27f3164f9ecd957df31e9353a94d26c715c"
        }
    },
    "extract_dir": "core",
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\zen\" \"$persist_dir\\zen-appdata\" -Migrate"
        ]
    },
    "post_install": [
        "New-Item -ItemType Directory -Force -Path \"$dir\\distribution\" | Out-Null",
        "$policies = [ordered]@{ policies = [ordered]@{ DisableAppUpdate = $true } }",
        "$json = $policies | ConvertTo-Json -Depth 5",
        "[System.IO.File]::WriteAllText(\"$dir\\distribution\\policies.json\", $json, (New-Object System.Text.UTF8Encoding $false))"
    ],
    "bin": "zen.exe",
    "shortcuts": [
        [
            "zen.exe",
            "Zen Browser"
        ],
        [
            "zen.exe",
            "Zen Browser Profile Manager",
            "-P"
        ]
    ],
    "persist": "distribution",
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\zen\""
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "    Remove-Item -Path \"$env:APPDATA\\zen\" -Recurse -Force -ErrorAction SilentlyContinue | Out-Null",
            "}"
        ]
    },
    "checkver": {
        "url": "https://github.com/zen-browser/desktop/tags",
        "regex": "releases/tag/([ab\\d.-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zen-browser/desktop/releases/download/$version/zen.installer.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/zen-browser/desktop/releases/download/$version/zen.installer-arm64.exe#/dl.7z"
            }
        }
    }
}
