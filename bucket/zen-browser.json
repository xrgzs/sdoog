{
    "version": "1.22.3b",
    "description": "Zen is a firefox-based browser with the aim of pushing your productivity to a new level!",
    "homepage": "https://zen-browser.app/",
    "license": "MPL-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/zen-browser/desktop/releases/download/1.22.3b/zen.installer.exe#/dl.7z",
            "hash": "1275177145fe6064e1a214bd76c1e0a2f134b0688b5162c2ec58b18a61dc84a9"
        },
        "arm64": {
            "url": "https://github.com/zen-browser/desktop/releases/download/1.22.3b/zen.installer-arm64.exe#/dl.7z",
            "hash": "b87b412e01cd652f62dd294bfc69f27f3164f9ecd957df31e9353a94d26c715c"
        }
    },
    "extract_dir": "core",
    "bin": "zen.exe",
    "shortcuts": [
        [
            "zen.exe",
            "Zen Browser"
        ],
        [
            "zen.exe",
            "Zen Browser Profile Manager",
            "-P"
        ]
    ],
    "persist": [
        "distribution"
    ],
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\zen\" \"$persist_dir\\AppData\" -Migrate"
        ]
    },
    "post_install": [
        "Remove-Item \"$dir\\update-settings.ini\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\updater.exe\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\updater.ini\" -Force -ErrorAction SilentlyContinue",
        "Remove-Item \"$dir\\uninstall\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\zen\""
    ],
    "checkver": {
        "github": "https://github.com/zen-browser/desktop",
        "regex": "/releases/tag/([\\d.]+-?b[.\\d]?)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/zen-browser/desktop/releases/download/$version/zen.installer.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/zen-browser/desktop/releases/download/$version/zen.installer-arm64.exe#/dl.7z"
            }
        }
    }
}
