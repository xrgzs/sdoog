{
    "version": "1.1.0",
    "description": "跨平台桌面音乐播放器，支持丰富歌词与多种音频格式",
    "homepage": "https://github.com/SPlayer-Dev/SPlayer-Next",
    "license": "AGPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/SPlayer-Dev/SPlayer-Next/releases/download/v1.1.0/SPlayer-Next-1.1.0-x64-setup.exe#/dl.7z",
            "hash": "3993d66159e54a1641b8d2ff6b609932029dc08f61542ce5790c7ab12ada6624",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
        },
        "arm64": {
            "url": "https://github.com/SPlayer-Dev/SPlayer-Next/releases/download/v1.1.0/SPlayer-Next-1.1.0-arm64-setup.exe#/dl.7z",
            "hash": "0b64e5a9126d7723a6edfcaf08670cbb8b0239a295bb5f4cc291133c66df4ce0",
            "pre_install": "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\""
        }
    },
    "shortcuts": [
        [
            "SPlayer-Next.exe",
            "SPlayer Next"
        ]
    ],
    "installer": {
        "script": [
            "Remove-Item \"$dir\\`$PLUGINSDIR\", \"$dir\\`$*\", \"$dir\\Uninstall*\" -Force -Recurse -ErrorAction SilentlyContinue",
            "Remove-Item \"$dir\\resources\\app-update.yml\" -Force -ErrorAction SilentlyContinue",
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:APPDATA\\SPlayer-Next\" \"$persist_dir\\AppData\" -Migrate",
            "if (!(Test-Path \"$persist_dir\\AppData\\app-data\\config\\settings.json\") -or !(Get-Item \"$persist_dir\\AppData\\app-data\\config\\settings.json\").Length) {",
            "    New-Item \"$persist_dir\\AppData\\app-data\\config\\settings.json\" -ItemType File -Force -ErrorAction SilentlyContinue | Out-Null",
            "    Set-Content -Path \"$persist_dir\\AppData\\app-data\\config\\settings.json\" -Value '{\"update\":{\"autoCheck\":false}}' -Encoding UTF8 -Force -ErrorAction SilentlyContinue | Out-Null",
            "}"
        ]
    },
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:APPDATA\\SPlayer-Next\""
    ],
    "checkver": {
        "github": "https://github.com/SPlayer-Dev/SPlayer-Next"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SPlayer-Dev/SPlayer-Next/releases/download/v$version/SPlayer-Next-$version-x64-setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://github.com/SPlayer-Dev/SPlayer-Next/releases/download/v$version/SPlayer-Next-$version-arm64-setup.exe#/dl.7z"
            }
        }
    }
}
