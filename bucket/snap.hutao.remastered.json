    "homepage": "https://snaphutaorp.org/",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/SnapHutaoRemasteringProject/Snap.Hutao.Remastered/releases/download/2.0.1/Snap.Hutao.Remastered-2.0.1.0.msix",
            "hash": "d27e19be49a651c6a15cae3f38f28dcdd132eee6f4c6d52285d45958f76b9b90"
        }
    },
    "installer": {
        "script": [
            ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
            "New-PersistDirectory \"$env:LocalAppData\\SnapHutaoRemastered\" \"$persist_dir\\data\" -Migrate"
        ]
    },
    "shortcuts": [
        [
            "Snap.Hutao.Remastered.exe",
            "Snap Hutao Remastered"
        ]
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App",
        "Remove-Junction \"$env:LocalAppData\\SnapHutaoRemastered\""
    ],
    "checkver": {
        "url": "https://api.github.com/repos/SnapHutaoRemasteringProject/Snap.Hutao.Remastered/releases/latest",
        "jsonpath": "$.tag_name",
        "regex": "v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/SnapHutaoRemasteringProject/Snap.Hutao.Remastered/releases/download/$version/Snap.Hutao.Remastered-$version.0.msix"
            }
        }
    }
}
