{
    "version": "3.2.7.98",
    "description": "极速看图，不止于快。",
    "homepage": "https://pic.ghxi.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://pic.ghxi.com/legal"
    },
    "architecture": {
        "64bit": {
            "url": "https://rj.lovestu.com/api/v1/release-files/131/download#/dl.7z",
            "hash": "f577d810f4da0b749526937406fbb1699bb8da029334efa0fb5d31ea629630eb"
        }
    },
    "extract_dir": "GuoheViewPortable",
    "pre_install": [
        "Remove-Item \"$dir\\GuoheView-Updater.exe\", \"$dir\\news.exe\" -Force -ErrorAction SilentlyContinue | Out-Null",
        "if (!(Test-Path \"$dir\\config.ini\") -or !(Get-Item \"$dir\\config.ini\").Length) {",
        "    New-Item \"$dir\\config.ini\" -ItemType File -Force -ErrorAction SilentlyContinue | Out-Null",
        "}"
    ],
    "shortcuts": [
        [
            "GuoheView.exe",
            "果核看图"
        ]
    ],
    "persist": [
        "config.ini",
        "plugins",
        "portable.ini"
    ],
    "pre_uninstall": [
        "$bucket = $install.bucket",
        ". \"$bucketsdir\\$bucket\\bin\\utils.ps1\"",
        "Stop-App"
    ],
    "checkver": {
        "script": [
            "$response = Invoke-RestMethod -Uri 'https://rj.lovestu.com/download/gh_view'",
            "$version = \"$($response.data.version).$($response.data.version_code)\"",
            "$file = $response.data.files | Where-Object { $_.name -like '*.7z' }",
            "return \"$version=====$($file.md5)=====$($file.url)\""
        ],
        "regex": "(.*)=====(?<md5>.*)=====(?<url>.*)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "$matchUrl#/dl.7z",
                "hash": {
                    "url": "https://httpbin.org/get?md5=$matchMd5",
                    "jsonpath": "$.args.md5"
                }
            }
        }
    }
}
